<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxWidth="350dp"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="25dp"
    android:layout_gravity="center"
    android:gravity="center_horizontal">

    <!-- Título -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirmar Asistencia"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginBottom="4dp"/>

    <!-- Subtítulo gris -->
    <TextView
        android:id="@+id/labelCodigo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Código de estudiante"
        android:textAlignment="center"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <!-- Código -->
    <TextView
        android:id="@+id/txtCodigo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="S-12345678"
        android:textAlignment="center"
        android:textColor="#00BCD4"
        android:textSize="18sp"
        android:layout_marginBottom="32dp" /> <!-- 🔸 Aumentamos margen inferior para empujar los botones hacia abajo -->

    <!-- Contenedor de botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"> <!-- 🔸 Añade algo de aire abajo -->

        <Button
            android:id="@+id/btnAsistio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asistió"
            android:textColor="@android:color/white"
            android:backgroundTint="#A5D6A7"
            android:drawableLeft="@drawable/ic_check"
            android:layout_marginEnd="5dp"
            />

<!--        <View-->
<!--            android:layout_width="5dp"-->
<!--            android:layout_height="wrap_content" />-->

        <Button
            android:id="@+id/btnTarde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tarde"
            android:textColor="@android:color/white"
            android:backgroundTint="#FFAB91"
            android:drawableLeft="@drawable/ic_time"/>

    </LinearLayout>

</LinearLayout>


